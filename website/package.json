{
  "name": "mactextify-website",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --test scripts/*.test.mjs",
    "check:format": "prettier --check src scripts vite.config.js index.html tsconfig.json",
    "prepare:download": "node scripts/prepare-download.mjs"
  },
  "engines": { "node": ">=22.12.0" },
  "dependencies": {
    "@fontsource-variable/manrope": "5.2.8",
    "animejs": "4.5.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "axe-core": "^4.14.0",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3",
    "vite": "8.3.5"
  }
}
